{
  "expo": {
    "name": "MedSupply",
    "slug": "MedSupply",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "medsupply",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "172d4cf4-26e6-4182-9dfe-436fd5292d8e"
      }
    },
    "android": {
      "package": "com.khalidali11.MedSupply"
    }
  }
}
